+// A bounded streaming transfer. Delegate callbacks never touch the UI or logger.
+// Only HTTPS, same-origin, same-mount URLs; CDN should proxy this hostname.
+private final class MTXTransfer: NSObject, URLSessionDataDelegate {
+    private let expected: Int64?
+    private let limit: Int64
+    private let output: FileHandle?
+    private let progress: (Int64) -> Void
+    private let permitted: (URL) -> Bool
+    private var bytes: Int64 = 0
+    private var data = Data()
+    private var failure: Error?
+    private let done = DispatchSemaphore(value: 0)
+    private var accepted = false
+    init(expected: Int64?, limit: Int64, output: FileHandle?, permitted: @escaping (URL) -> Bool, progress: @escaping (Int64) -> Void) {
+        self.expected = expected; self.limit = limit; self.output = output
+        self.permitted = permitted; self.progress = progress
+    }
+    func run(_ request: URLRequest) throws -> Data {
+        let config = URLSessionConfiguration.ephemeral
+        config.timeoutIntervalForRequest = 30; config.timeoutIntervalForResource = 900
+        config.requestCachePolicy = .reloadIgnoringLocalCacheData
+        config.httpCookieStorage = nil; config.urlCache = nil
+        let queue = OperationQueue(); queue.maxConcurrentOperationCount = 1
+        let session = URLSession(configuration: config, delegate: self, delegateQueue: queue)
+        let task = session.dataTask(with: request); task.resume()
+        done.wait() // Only on the detached worker, never the main thread.
+        session.finishTasksAndInvalidate()
+        if let error = failure { throw error }
+        guard accepted, expected == nil || bytes == expected else { throw downloadFailure("下载内容不完整，请重试。") }
+        return data
+    }
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse, newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) {
+        // Redirects can turn ticket POST into GET or leak temporary credentials.
+        failure = downloadFailure("更新地址发生跳转，请联系发布者检查 CDN 配置。")
+        completionHandler(nil)
+    }
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive response: URLResponse, completionHandler: @escaping (URLSession.ResponseDisposition) -> Void) {
+        guard let http = response as? HTTPURLResponse, let url = response.url, permitted(url), http.statusCode == 200 else {
+            failure = downloadFailure("连接更新服务失败，请检查网络或稍后重试。")
+            completionHandler(.cancel); return
+        }
+        guard response.expectedContentLength <= limit,
+              expected == nil || response.expectedContentLength < 0 || response.expectedContentLength == expected else {
+            failure = downloadFailure("下载大小与发布信息不一致，请重试。")
+            completionHandler(.cancel); return
+        }
+        accepted = true; completionHandler(.allow)
+    }
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive chunk: Data) {
+        guard failure == nil else { return }
+        bytes += Int64(chunk.count)
+        guard bytes <= limit, expected == nil || bytes <= expected! else {
+            failure = downloadFailure("下载超出声明大小，请联系发布者。")
+            dataTask.cancel(); return
+        }
+        do {
+            if let file = output { try file.write(contentsOf: chunk) } else { data.append(chunk) }
+            progress(bytes)
+        } catch { failure = downloadFailure("本地空间不足或文件写入失败。请清理空间后重试。"); dataTask.cancel() }
+    }
+    func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
+        if failure == nil && error != nil { failure = downloadFailure("下载中断，请检查网络后重试。") }
+        done.signal()
+    }
