+    id e = [NSJSONSerialization JSONObjectWithData:envelope options:0 error:NULL];
+    if (![e isKindOfClass:NSDictionary.class] || ![e[@"key_id"] isEqual:MTX_REMOTE_KEY_ID] ||
+        ![e[@"payload_base64"] isKindOfClass:NSString.class] || ![e[@"native_signature_base64"] isKindOfClass:NSString.class]) REMOTE_FAIL("更新签名字段异常。");
+    NSData *raw = [[NSData alloc] initWithBase64EncodedString:e[@"payload_base64"] options:0];
+    NSData *sig = [[NSData alloc] initWithBase64EncodedString:e[@"native_signature_base64"] options:0];
+    NSData *pub = [[NSData alloc] initWithBase64EncodedString:MTX_REMOTE_PUBLIC_KEY options:0];
+    if (!raw || raw.length > 65536 || !sig || sig.length > 80 || pub.length != 65) REMOTE_FAIL("更新签名格式异常。");
+    NSDictionary *attributes = @{(__bridge id)kSecAttrKeyType:(__bridge id)kSecAttrKeyTypeECSECPrimeRandom,
+        (__bridge id)kSecAttrKeyClass:(__bridge id)kSecAttrKeyClassPublic, (__bridge id)kSecAttrKeySizeInBits:@256};
+    SecKeyRef key = SecKeyCreateWithData((__bridge CFDataRef)pub, (__bridge CFDictionaryRef)attributes, NULL);
+    BOOL valid = key && SecKeyVerifySignature(key, kSecKeyAlgorithmECDSASignatureMessageX962SHA256,
+                                               (__bridge CFDataRef)raw, (__bridge CFDataRef)sig, NULL);
+    if (key) CFRelease(key);
