+// Native verification is shared by the UI process and the one-shot helper.
+// PHP: ECDSA P-256 / SHA-256, DER X9.62 signature over original payload bytes.
+#import <Security/Security.h>
+#ifndef MTX_REMOTE_CONFIG_HEADER
+#define MTX_REMOTE_CONFIG_HEADER "MTXRemote.generated.h"
+#endif
+#import MTX_REMOTE_CONFIG_HEADER
+NSString *MTXRemoteUpdateURL(void) { return MTX_REMOTE_UPDATE_URL; }
+NSString *MTXRemoteAppKey(void) { return MTX_REMOTE_APP_KEY; }
+NSString *MTXRemoteProfile(void) { return MTX_REMOTE_PROFILE; }
+static BOOL RemoteHex(id value, NSUInteger length) {
+    return [value isKindOfClass:NSString.class] && [value length] == length &&
+        [value rangeOfCharacterFromSet:[[NSCharacterSet characterSetWithCharactersInString:@"0123456789abcdef"] invertedSet]].location == NSNotFound;
+}
+static BOOL RemoteSize(id value) {
+    return [value isKindOfClass:NSNumber.class] && CFGetTypeID((__bridge CFTypeRef)value) != CFBooleanGetTypeID() &&
+        [value doubleValue] == [value longLongValue] && [value longLongValue] > 0 && [value longLongValue] <= 268435456;
+}
+static BOOL RemoteVersion(id value) {
+    if (![value isKindOfClass:NSString.class] || [value length] > 12) return NO;
+    return [value rangeOfString:@"^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$" options:NSRegularExpressionSearch].location != NSNotFound;
+}
+NSDictionary *MTXVerifyRemoteEnvelope(NSData *envelope, NSString *nonce, NSError **error) {
+    #define REMOTE_FAIL(MSG) { Fail(error, @MSG); return nil; }
