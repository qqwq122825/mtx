+    id p = [NSJSONSerialization JSONObjectWithData:raw options:0 error:NULL];
+    if (![p isKindOfClass:NSDictionary.class] || ![p[@"schema_version"] isEqual:@1] ||
+        ![p[@"app_key"] isEqual:MTX_REMOTE_APP_KEY] || (nonce && ![p[@"nonce"] isEqual:nonce])) REMOTE_FAIL("更新身份或请求校验失败。");
+    if (![p[@"issued_at"] isKindOfClass:NSString.class] || ![p[@"expires_at"] isKindOfClass:NSString.class]) REMOTE_FAIL("更新有效期缺失。");
+    NSISO8601DateFormatter *formatter = [NSISO8601DateFormatter new];
+    NSDate *issued = [formatter dateFromString:p[@"issued_at"]], *expires = [formatter dateFromString:p[@"expires_at"]];
+    NSTimeInterval now = NSDate.date.timeIntervalSince1970;
+    if (!issued || !expires || issued.timeIntervalSince1970 > now+60 || expires.timeIntervalSince1970 < now ||
+        [expires timeIntervalSinceDate:issued] <= 0 || [expires timeIntervalSinceDate:issued] > 600) REMOTE_FAIL("更新信息已过期，请检查系统时间后重试。");
+    NSArray *allowed = @[@"no_release",@"client_upgrade_required",@"incompatible",@"version_unknown",@"up_to_date",@"update_available"];
+    if (![allowed containsObject:p[@"status"]]) REMOTE_FAIL("更新状态异常。");
+    id r = p[@"release"];
+    if ([r isEqual:NSNull.null]) return p;
+    if (![r isKindOfClass:NSDictionary.class] || ![@[@"version_unknown",@"up_to_date",@"update_available"] containsObject:p[@"status"]] ||
+        ![r[@"bundle_id"] isEqual:MTX_REMOTE_BUNDLE_ID] || ![r[@"profile_id"] isEqual:MTX_REMOTE_PROFILE] ||
+        ![r[@"artifact_format"] isEqual:@"prepared-payload-v1"] || !RemoteHex(r[@"release_id"],32) ||
+        !RemoteHex(r[@"source_sha256"],64) || !RemoteHex(r[@"artifact_sha256"],64) || !RemoteHex(r[@"manifest_sha256"],64) ||
+        !RemoteSize(r[@"source_bytes"]) || !RemoteSize(r[@"artifact_bytes"]) || !RemoteSize(r[@"sequence"]) ||
+        !RemoteVersion(r[@"min_ios"]) || !RemoteVersion(r[@"max_ios"]) || !RemoteVersion(r[@"min_installer_version"])) REMOTE_FAIL("更新包契约不匹配，请更新安装器。");
+    return p;
+    #undef REMOTE_FAIL
+}
