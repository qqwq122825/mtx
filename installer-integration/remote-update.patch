+from pathlib import Path
+import unittest
+ROOT=Path(__file__).resolve().parents[1]
+class RemoteUpdateTests(unittest.TestCase):
+    def test_download_phase_is_retryable_and_precedes_diagnostics(self):
+        ui=(ROOT/'TrollInstallerX/UI/MainView.swift').read_text()
+        phase=ui[ui.index('private func start()'):ui.index('private func startInstallation')]
+        self.assertLess(phase.index('update.prepare()'),phase.index('getKernel(target)'))
+        self.assertLess(phase.index('getKernel(target)'),phase.index('startInstallation(payload)'))
+        self.assertNotIn('diagnostics.begin',phase)
+        self.assertNotIn('hasRun = true',phase)
+        self.assertIn('running = false',phase)
+        self.assertIn('downloadError =',phase)
+        self.assertIn('ProgressView(value: transfer.fraction)',ui)
+    def test_network_and_kernel_download_do_not_record_diagnostics(self):
+        download=(ROOT/'TrollInstallerX/Installer/MTXRemoteUpdater.swift').read_text()
+        install=(ROOT/'TrollInstallerX/Installer/Installation.swift').read_text()
+        kernel=install[install.index('func getKernel'):install.index('func selectExploit')]
+        self.assertNotIn('Logger.',download)
+        self.assertNotIn('Logger.',kernel)
+        self.assertNotIn('NSLog',kernel)
+        self.assertNotIn('Bundle.main.url(forResource: "MTXPayload"',install)
+    def test_remote_helper_requires_independent_validation(self):
+        host=(ROOT/'TrollInstallerX/Installer/MTXHostInstaller.m').read_text()
+        self.assertIn('MTXVerifyRemoteEnvelope(payload.remoteEnvelope',host)
+        self.assertIn('DataSHA256(payload.manifestBytes)',host)
+        self.assertIn('MTXLoadStagedPayload(stage', (ROOT/'Helper/MTXInstallHelper.m').read_text())
+        self.assertIn('MTXRemote.generated.h', (ROOT/'Tools/prepare_helper.py').read_text())
+    def test_install_tap_starts_automatically_without_release_dialog(self):
+        ui=(ROOT/'TrollInstallerX/UI/MainView.swift').read_text()
+        self.assertIn('Button(downloadError == nil ? "安装" : "重试下载") { start() }',ui)
+        self.assertNotIn('confirmation = .install',ui)
+        self.assertNotIn('Text("继续")',ui)
+        self.assertNotIn('changelog',ui)
+        self.assertIn('Button("确认安装到',ui)
+        self.assertIn('本次未替换任何 App',ui)
